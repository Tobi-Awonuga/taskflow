{
  "manifest_version": 3,
  "name": "CT Bakery — Item Creation Guard",
  "version": "1.0.0",
  "description": "Enforces the item creation approval workflow in Masterplan ERP. Requires an approved request before any new item can be saved.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://no1.masterplansolutions.com/*",
    "http://localhost:3001/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://no1.masterplansolutions.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "CT Bakery — Item Creation Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
