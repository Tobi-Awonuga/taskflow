# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ctbakery_support

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Required for automatic item-creation notifications.
# For Microsoft 365 (Office 365), use:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# For Gmail, use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# If SMTP_HOST is left blank the server will log emails to the console
# instead of sending them (useful for local development).

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@ctbakery.com
SMTP_PASS=your-smtp-app-password-here
SMTP_FROM=CT Bakery ERP <noreply@ctbakery.com>

# Address that receives item-creation notifications (ERP coordinator)
ERP_NOTIFY_EMAIL=tobi.awonuga@ctbakery.com
